{
  "name": "@campus-os/monorepo",
  "version": "0.0.1",
  "description": "The Operating System for Campus Management — A modular, scalable platform for managing the complete lifecycle of campus activities.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "pnpm -r --filter backend --filter frontend run dev",
    "build": "pnpm -r --filter frontend run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "plugin:create": "node scripts/plugin.js create",
    "plugin:install": "node scripts/plugin.js install",
    "plugin:uninstall": "node scripts/plugin.js uninstall",
    "plugin:sync": "node scripts/plugin.js generate-registry",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r --filter frontend run type-check"
  },
  "keywords": [
    "campus-management",
    "event-management",
    "club-management",
    "modular-architecture",
    "plugin-system",
    "open-source"
  ],
  "author": "CampusOS Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NITRR-Official/CampusOS"
  },
  "homepage": "https://github.com/NITRR-Official/CampusOS#readme",
  "bugs": {
    "url": "https://github.com/NITRR-Official/CampusOS/issues"
  },
  "workspaces": [
    "apps/*",
    "backend",
    "frontend",
    "shared"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "adm-zip": "^0.5.17",
    "mongoose": "^9.6.1",
    "next": "16.2.2",
    "react": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.3.0",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^3.23.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.1"
  }
}
